# Copy to .env and fill in values
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"

APP_NAME=MathVerse AI
DEBUG=false
FRONTEND_URL=https://your-app.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app

LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-1.5-pro

# Railway sets DATABASE_URL automatically when you add a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_EXPIRE_HOURS=720

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Admin dashboard access ────────────────────────────────────────────────────
# Comma-separated emails that can access /api/v1/admin/dashboard
# If left empty, the admin dashboard is locked for everyone
ADMIN_EMAILS=you@example.com
